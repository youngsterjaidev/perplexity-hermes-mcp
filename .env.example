# ─── Hermes Agent (large VM, internal network) ────────────────────────────────
# Base URL of Hermes API server. Keep this on the internal OCI network.
HERMES_BASE_URL=http://10.0.0.2:8642/v1

# Must match API_SERVER_KEY in ~/.hermes/.env on the Hermes VM
HERMES_API_KEY=change-me-hermes-api-key

# ─── Perplexity Connector Auth ────────────────────────────────────────────────
# This is the key you will paste into Perplexity when adding the custom connector.
CONNECTOR_API_KEY=change-me-connector-key

# ─── Server settings ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Timeout in seconds for Hermes task calls (long-running tasks may need more)
HERMES_TIMEOUT=120
